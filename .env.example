# SERPER_API_KEY: Required for Serper.dev Google Search API integration in Scoutly AI
SERPER_API_KEY=

# RankFabrik Places: optional sparse-search fallback for local businesses.
# Trial: 500 returned places/month. Server-only. Either variable works.
RANKFABRIK_PLACES_KEY=
# RANKFABRIK_API_KEY=
# Optional override; defaults to https://places.rankfabrik.com
# RANKFABRIK_PLACES_URL=

# PeopleSearch.im: optional decision-maker / LinkedIn lookup for Scoutly Agentic.
# Searching is free; revealing a profile spends provider credits. Server-only.
PEOPLESEARCH_API_KEY=

# Omkar Google Maps Extractor worker.
# The scraper opens Chrome/Botasaurus, so host it on an Ubuntu/Debian VM and
# point Scoutly at its Botasaurus Desktop API. Do not run Chrome inside Vercel.
OMKAR_MAPS_API_URL=
# Optional Botasaurus API base path, if your worker uses one.
OMKAR_MAPS_API_BASE_PATH=
# Optional scraper name exposed by the installed Google Maps Extractor.
OMKAR_MAPS_SCRAPER_NAME=
# Optional bearer token when the worker is behind an authenticated reverse proxy.
OMKAR_MAPS_BRIDGE_TOKEN=
# Optional exact input JSON from the Extractor "API Integration" page.
# Supported placeholders: {{query}}, {{region}}, {{search}}, {{lat}}, {{lng}}, {{maxResults}}
# OMKAR_MAPS_INPUT_TEMPLATE_JSON={"queries":["{{search}}"],"search_strategy":"fastest","max_results":"{{maxResults}}"}
# Set true only if you deliberately want Free users to consume external Google Maps searches.
OMKAR_MAPS_ALLOW_FREE=false

# GOOGLE_PAGESPEED_API_KEY: Optional Google PageSpeed Insights API key
GOOGLE_PAGESPEED_API_KEY=

# AI_GATEWAY_API_KEY: Recommended. Vercel AI Gateway key (first in the AI fallback chain). Optional AI_GATEWAY_MODELS=provider/model,provider/model
AI_GATEWAY_API_KEY=

# OPENROUTER_API_KEY: Required for OpenRouter AI assistant
OPENROUTER_API_KEY=

# UNSPLASH_ACCESS_KEY: Optional (Access Key from unsplash.com/developers). Real photos for the demo websites at /demo/<slug>.
# Without it the demo sites use art-directed vector visuals instead of photos.
UNSPLASH_ACCESS_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls and fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MAPBOX_ACCESS_TOKEN: Required for map-related integrations when used.
MAPBOX_ACCESS_TOKEN="MY_MAPBOX_ACCESS_TOKEN"

# APP_URL: Public application URL.
APP_URL="MY_APP_URL"

# Resend lifecycle emails. Server-only. Used to emit the user.created event
# that triggers the Scoutly welcome automation. Configure in Vercel, never VITE_*.
RESEND_API_KEY="re_..."

# VITE_FIREBASE_AUTH_DOMAIN: Custom Firebase Auth Domain.
VITE_FIREBASE_AUTH_DOMAIN="auth.scoutly.pro"

# Brazil-first local places index.
# Server-only. NEVER expose the service role key to Vite/frontend variables.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Overture release used by the one-time/periodic Brazil importer.
OVERTURE_RELEASE="2026-08-19.0"
IMPORT_BATCH_SIZE="500"

# Stripe billing. Server-only. Configure these in Vercel, never in VITE_* variables.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_GO="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."
STRIPE_PRICE_AGENCY_EXTRA_SEAT="price_..."
STRIPE_PORTAL_CONFIGURATION_ID="bpc_..."


# Scoutly user/application database. Server-only. Stores profiles, settings, pipeline,
# favorites, routes, recommendation signals, recent views, generated messages,
# subscription metadata and usage counters.
SCOUTLY_APP_SUPABASE_URL="https://fpyfphabdjutwqlwjwib.supabase.co"
SCOUTLY_APP_SUPABASE_SECRET_KEY="sb_secret_..."
FIREBASE_PROJECT_ID="gen-lang-client-0931227900"

# Worldwide places archive (see docs/GLOBAL_PLACES.md)
# Public base URL (ending with "/") that holds manifest.json + places-<release>.pmtiles on Cloudflare R2
SCOUTLY_PLACES_URL=
# Secret that decrypts the e-mails stored in the archive (same value as the GitHub Actions secret)
SCOUTLY_PLACES_KEY=

# CRON_SECRET: protects /api/cron-alerts (daily new-company alert emails). Any long random string; Vercel sends it as a bearer token to the cron.
CRON_SECRET="long-random-string"
