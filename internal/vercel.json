{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/bootstrap", "dest": "/api/bootstrap.ts" },
    { "src": "/api/tickets", "dest": "/api/tickets.ts" },
    { "src": "/api/users", "dest": "/api/users.ts" },
    { "src": "/api/audit", "dest": "/api/audit.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}