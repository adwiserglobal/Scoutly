{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/internal/intern/?",
      "dest": "/internal/intern/index.html"
    },
    {
      "src": "/(login|dashboard|favoritos|pipeline|workspace|configuracoes|convite(?:/.*)?|api(?:/.*)?|internal(?:/.*)?|__/auth(?:/.*)?)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/__/auth/(.*)",
      "dest": "https://gen-lang-client-0931227900.firebaseapp.com/__/auth/$1"
    },
    {
      "src": "/api/places-fast",
      "dest": "/api/places-fast.ts"
    },
    {
      "src": "/api/omkar-maps",
      "dest": "/api/search.ts?__scoutly_handler=omkar-maps"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/location-suggestions",
      "dest": "/api/location-suggestions.ts"
    },
    {
      "src": "/api/places",
      "dest": "/api/places-fast.ts"
    },
    {
      "src": "/api/ai/chat",
      "dest": "/api/ai/chat.ts"
    },
    {
      "src": "/api/ai/suggestions",
      "dest": "/api/ai/suggestions.ts"
    },
    {
      "src": "/api/ai/generate-message",
      "dest": "/api/ai/generate-message.ts"
    },
    {
      "src": "/api/enrich",
      "dest": "/api/enrich.ts"
    },
    {
      "src": "/api/tracking-audit",
      "dest": "/api/tracking-audit.ts"
    },
    {
      "src": "/api/social-check",
      "dest": "/api/enrich.ts?__scoutly_handler=social-check"
    },
    {
      "src": "/api/pagespeed",
      "dest": "/api/pagespeed.ts"
    },
    {
      "src": "/api/cron-alerts",
      "dest": "/api/leads.ts?__scoutly_handler=alerts-cron"
    },
    {
      "src": "/api/leads",
      "dest": "/api/leads.ts"
    },
    {
      "src": "/api/geo",
      "dest": "/api/pagespeed.ts?__scoutly_handler=geo"
    },
    {
      "src": "/api/jobs",
      "dest": "/api/enrich.ts?__scoutly_handler=jobs"
    },
    {
      "src": "/api/flash-promo",
      "dest": "/api/pagespeed.ts?__scoutly_handler=flash-promo"
    },
    {
      "src": "/api/stripe-webhook",
      "dest": "/api/stripe-webhook.ts"
    },
    {
      "src": "/(prospeccao-local|prospeccao-com-ia|para-agencias|recursos|dados-e-fontes|perguntas-frequentes|en)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/demo/([a-z0-9-]+)/?",
      "dest": "/api/leads?view=demo&slug=$1"
    },
    {
      "src": "/blog/?",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/([a-z0-9-]+)/?",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/ajuda/?",
      "dest": "/ajuda/index.html"
    },
    {
      "src": "/ajuda/([a-z0-9-]+)/?",
      "dest": "/ajuda/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/leads.ts": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,scripts/**,supabase/**}"
    },
    "api/ai/generate-message.ts": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,scripts/**,supabase/**}"
    },
    "api/**/*.ts": {
      "excludeFiles": "{data/**,scripts/**,supabase/**}"
    },
    "api/ai/chat.ts": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,scripts/**,supabase/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron-alerts",
      "schedule": "0 11 * * *"
    }
  ]
}
